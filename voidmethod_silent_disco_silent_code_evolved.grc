- name: snippet_0
  id: snippet
  parameters:
    alias: ''
    code: "from PyQt5 import Qt, QtCore, QtGui\n\n\nclass ChannelMarkerOverlay(Qt.QWidget):\n\
      \    \"\"\"Transparent channel-marker layer drawn over a waterfall canvas.\"\
      \"\"\n\n    def __init__(\n        self,\n        canvas,\n        first_frequency,\n\
      \        center_frequency,\n        bandwidth,\n        channel_half_width,\n\
      \    ):\n        super().__init__(canvas)\n        self.canvas = canvas\n  \
      \      self.first_frequency = first_frequency\n        self.center_frequency\
      \ = center_frequency\n        self.bandwidth = bandwidth\n        self.channel_half_width\
      \ = channel_half_width\n\n        self.setAttribute(QtCore.Qt.WA_TransparentForMouseEvents,\
      \ True)\n        self.setAttribute(QtCore.Qt.WA_TranslucentBackground, True)\n\
      \        self.setAutoFillBackground(False)\n\n        self.canvas.installEventFilter(self)\n\
      \        self.setGeometry(self.canvas.rect())\n        self.show()\n       \
      \ self.raise_()\n\n    def eventFilter(self, watched, event):\n        if watched\
      \ is self.canvas and event.type() in (\n            QtCore.QEvent.Resize,\n\
      \            QtCore.QEvent.Show,\n        ):\n            self.setGeometry(self.canvas.rect())\n\
      \            self.raise_()\n\n        return False\n\n    def paintEvent(self,\
      \ event):\n        del event\n\n        painter = QtGui.QPainter(self)\n   \
      \     painter.setRenderHint(QtGui.QPainter.Antialiasing, True)\n\n        line_pen\
      \ = QtGui.QPen(QtGui.QColor(255, 40, 40, 230))\n        line_pen.setWidth(2)\n\
      \        line_pen.setStyle(QtCore.Qt.DashLine)\n        painter.setPen(line_pen)\n\
      \n        low_frequency = self.center_frequency - self.bandwidth / 2.0\n\n \
      \       for index in range(10):\n            channel = 11 + index\n        \
      \    center_frequency = self.first_frequency + index * 550e3\n            edge_frequencies\
      \ = (\n                center_frequency - self.channel_half_width,\n       \
      \         center_frequency + self.channel_half_width,\n            )\n\n   \
      \         for edge_frequency in edge_frequencies:\n                normalized_x\
      \ = (\n                    (edge_frequency - low_frequency) / self.bandwidth\n\
      \                )\n                edge_x = normalized_x * self.width()\n\n\
      \                if edge_x < 0 or edge_x > self.width():\n                 \
      \   continue\n\n                painter.drawLine(\n                    QtCore.QPointF(edge_x,\
      \ 0),\n                    QtCore.QPointF(edge_x, self.height()),\n        \
      \        )\n\n            center_x = (\n                (center_frequency -\
      \ low_frequency) / self.bandwidth\n            ) * self.width()\n\n        \
      \    if center_x < 0 or center_x > self.width():\n                continue\n\
      \n            label_rect = QtCore.QRectF(center_x - 28, 2, 56, 20)\n       \
      \     painter.fillRect(\n                label_rect,\n                QtGui.QColor(0,\
      \ 0, 0, 170),\n            )\n            painter.drawText(\n              \
      \  label_rect,\n                QtCore.Qt.AlignCenter,\n                f\"\
      CH {channel}\",\n            )\n\n        painter.end()\n\n\nwaterfall_widget\
      \ = self._qtgui_waterfall_sink_x_0_win\n\n# GNU Radio's C++ plot cannot always\
      \ be discovered through its Qwt base\n# class. Its canvas is still visible as\
      \ a normal child QWidget, so draw a\n# transparent overlay directly on that\
      \ canvas.\ncanvas = None\n\nfor child in waterfall_widget.findChildren(Qt.QWidget):\n\
      \    class_name = child.metaObject().className()\n\n    if \"PlotCanvas\" in\
      \ class_name or class_name == \"QwtPlotCanvas\":\n        canvas = child\n \
      \       break\n\nif canvas is None:\n    print(\"Could not find the waterfall\
      \ plot canvas\")\n    print(\"Available child widgets:\")\n\n    for child in\
      \ waterfall_widget.findChildren(Qt.QWidget):\n        print(\"  \", child.metaObject().className())\n\
      else:\n    print(\"Adding channel overlay to\", canvas.metaObject().className())\n\
      \n    self._silent_disco_channel_overlay = ChannelMarkerOverlay(\n        canvas=canvas,\n\
      \        first_frequency=self.first_channel_freq,\n        center_frequency=self.rf_center_freq,\n\
      \        bandwidth=self.samp_rate,\n        channel_half_width=140e3,\n    )"
    comment: ''
    priority: '0'
    section: main_after_init
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [112, 248.0]
    rotation: 0
    state: enabled
